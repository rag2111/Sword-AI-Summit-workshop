<!--
  /openai : model calls (Azure OpenAI-compatible: /openai/deployments/{d}/... and /openai/v1/...).
  The subscription key header for this API is "api-key", so Azure OpenAI SDKs work unchanged.
  Template variables: tokens_per_minute (number), content_safety (bool), openai_backend and
  content_safety_backend (APIM backend entity names).
-->
<policies>
  <inbound>
    <base />
    <!-- Never forward the caller's credentials: APIM calls Foundry with its own managed identity. -->
    <set-header name="api-key" exists-action="delete" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="Authorization" exists-action="delete" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
    <set-backend-service backend-id="${openai_backend}" />
    <!-- Model name for the token metric: from /deployments/{name}/ or from the JSON body on /openai/v1. -->
    <set-variable name="model" value='@{
        var m = System.Text.RegularExpressions.Regex.Match(context.Request.Url.Path, "deployments/([^/]+)/");
        if (m.Success) { return m.Groups[1].Value; }
        if (context.Request.Method != "POST") { return "none"; }
        try {
            var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
            return body["model"] != null ? body["model"].ToString() : "unknown";
        } catch (Exception) { return "unknown"; }
    }' />
    <!-- Per-participant token budget: the counter key is the APIM subscription (one per participant). -->
    <llm-token-limit counter-key="@(context.Subscription.Id)" tokens-per-minute="${tokens_per_minute}" estimate-prompt-tokens="false" remaining-tokens-header-name="x-ratelimit-remaining-tokens" tokens-consumed-header-name="x-tokens-consumed" />
    <!-- Token usage as custom metrics in Application Insights (workbook: per-participant usage). -->
    <llm-emit-token-metric namespace="care-workshop">
      <dimension name="Subscription ID" />
      <dimension name="User ID" value='@(context.Subscription != null ? context.Subscription.Name : "anonymous")' />
      <dimension name="API ID" />
      <dimension name="Model" value='@((string)context.Variables["model"])' />
    </llm-emit-token-metric>
%{ if content_safety ~}
    <!-- Optional: Azure AI Content Safety screening of prompts (enable_content_safety = true). -->
    <llm-content-safety backend-id="${content_safety_backend}" shield-prompt="true">
      <categories output-type="EightSeverityLevels">
        <category name="Hate" threshold="4" />
        <category name="Sexual" threshold="4" />
        <category name="SelfHarm" threshold="4" />
        <category name="Violence" threshold="4" />
      </categories>
    </llm-content-safety>
%{ endif ~}
  </inbound>
  <backend>
    <!-- Retry with backoff when the model deployment itself throttles (429) or is briefly unavailable. -->
    <retry condition="@(context.Response.StatusCode == 429 || context.Response.StatusCode == 503)" count="3" interval="2" delta="2" max-interval="20" first-fast-retry="false">
      <forward-request buffer-request-body="true" buffer-response="false" timeout="180" />
    </retry>
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
