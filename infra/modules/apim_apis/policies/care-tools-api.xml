<!--
  care-tools-api : the backing REST API of the MCP server (Container Apps mock backend).
  Participants reach these operations only as MCP tools on /care-tools/mcp.
  The shared secret (named value) proves to the backend that the call came through APIM.
-->
<policies>
  <inbound>
    <base />
    <set-header name="x-backend-secret" exists-action="override">
      <value>{{${secret_nv}}}</value>
    </set-header>
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="api-key" exists-action="delete" />
    <set-header name="Authorization" exists-action="delete" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
