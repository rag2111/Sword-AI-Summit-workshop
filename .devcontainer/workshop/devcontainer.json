{
  // GitHub Codespaces entry point at the repository root.
  // Codespaces only discovers dev containers under the root .devcontainer/ folder,
  // so this file opens the participant workspace in workshop/.
  // Training use only: synthetic data. You only need the three values in workshop/.env.
  "name": "Care Coordination Workshop (participants)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/workshop",
  "postCreateCommand": "pipx install uv && uv sync && ([ -f .env ] || cp .env.example .env)",
  "forwardPorts": [8000, 8080],
  "portsAttributes": {
    "8000": { "label": "Lab guide (poe docs)", "onAutoForward": "notify" },
    "8080": { "label": "Agent Framework DevUI", "onAutoForward": "notify" }
  },
  "containerEnv": { "UV_LINK_MODE": "copy" },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "bierner.markdown-mermaid",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
